<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.aoxter.thatwasgreat.ui.controller.NewEntryController">
    <top>
        <Label fx:id="headerLabel" alignment="CENTER" styleClass="title-1" BorderPane.alignment="CENTER" />
    </top>
    <center>
        <VBox alignment="CENTER" fillWidth="false" spacing="15">
            <Label text="Name" />
            <TextField fx:id="nameTextField" />
            <Label text="Description (optional)" />
            <TextArea fx:id="descriptionTextArea" prefHeight="200.0" prefWidth="200.0" wrapText="true" />
            <Label text="Rating" />
            <HBox alignment="CENTER_LEFT" spacing="10">
                <RadioButton text="1">
               <toggleGroup>
                  <ToggleGroup fx:id="ratingToggleGroup" />
               </toggleGroup>
                </RadioButton>
                <RadioButton text="2" toggleGroup="$ratingToggleGroup" />
                <RadioButton text="3" toggleGroup="$ratingToggleGroup" />
                <RadioButton text="4" toggleGroup="$ratingToggleGroup" />
                <RadioButton text="5" toggleGroup="$ratingToggleGroup" />
                <RadioButton text="6" toggleGroup="$ratingToggleGroup" />
                <RadioButton text="7" toggleGroup="$ratingToggleGroup" />
                <RadioButton text="8" toggleGroup="$ratingToggleGroup" />
                <RadioButton text="9" toggleGroup="$ratingToggleGroup" />
                <RadioButton text="10" toggleGroup="$ratingToggleGroup" />
            </HBox>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="15">
            <Button mnemonicParsing="false" onAction="#addOnAction" styleClass="success, large" text="Add" />
            <Button mnemonicParsing="false" onAction="#cancelOnAction" styleClass="danger, large" text="Cancel" />
        </HBox>
    </bottom>
</BorderPane>
